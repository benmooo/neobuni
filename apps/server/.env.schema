# @public @type=number
PORT=3000

# @type=url
NEOBUNI_APP_URL=http://localhost:3001

# @type=url
NEOBUNI_INTERNAL_API_BASE_URL=http://localhost:3000

# @optional
NEOBUNI_INTERNAL_API_TOKEN=

# @optional
RESEND_API_KEY=

# @optional
RESEND_FROM_EMAIL="Buni <onboarding@resend.dev>"

# --- Memory providers ---
# @optional
MEMORY_EMBEDDING_PROVIDER=qwen
# @optional
MEMORY_EMBEDDING_MODEL=text-embedding-v4
