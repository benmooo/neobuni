{
  "name": "neobuni",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "libsql": "0.5.29",
      "@orpc/server": "^1.15.6",
      "@orpc/openapi": "^1.15.6",
      "@orpc/zod": "^1.15.6",
      "better-auth": "1.7.7",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.15.6",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "auth:generate": "cd apps/server && bun run auth:generate",
    "build": "vp run -r build",
    "check": "vp check && vp run -r check-types",
    "check-types": "vp run -r check-types",
    "db:generate": "vp run --filter @neobuni/db db:generate",
    "db:local": "vp run --filter @neobuni/db db:local",
    "db:migrate": "vp run --filter @neobuni/db db:migrate",
    "db:push": "vp run --filter @neobuni/db db:push",
    "db:studio": "vp run --filter @neobuni/db db:studio",
    "dev": "vp run -r dev",
    "dev:server": "vp run --filter @neobuni/server dev",
    "dev:web": "vp run --filter web dev",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d --build",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "format": "vp fmt",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "lint": "vp lint",
    "staged": "vp staged"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/vitest": "4.0.5",
    "@neobuni/config": "workspace:*",
    "@types/bun": "catalog:",
    "effect": "4.0.5",
    "lefthook": "latest",
    "rolldown": "1.2.13",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.3"
}
