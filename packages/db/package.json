{
  "name": "@neobuni/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "db:local": "turso dev --db-file .data/neobuni.db",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@neobuni/contracts": "workspace:*",
    "@neobuni/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "4.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@neobuni/config": "workspace:*",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
